{
  "name": "@cosmicmind/domainjs",
  "version": "0.0.1-rc-082626-4",
  "description": "A domain-driven design framework for scalable systems.",
  "keywords": [
    "typescript",
    "domain-driven-design",
    "framework",
    "cosmicmind",
    "domainjs"
  ],
  "author": {
    "name": "Daniel Jonathan",
    "email": "daniel@cosmicverse.org"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosmicmind/domainjs.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/lib-cjs.cjs",
  "module": "./dist/lib-es.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/lib-es.js",
      "require": "./dist/lib-cjs.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "lint": "eslint --fix",
    "release": "npm run release:lib",
    "release:lib": "vite build --config vite.config.ts",
    "develop": "npm run develop:lib",
    "develop:lib": "vite build --config vite.config.ts --mode development",
    "watch": "vite build --watch --config vite.config.ts --mode development",
    "test": "vitest --config vite.config.test.ts",
    "test:unit": "vitest run --config vite.config.test.ts",
    "test:coverage": "vitest run --coverage --config vite.config.test.ts"
  },
  "dependencies": {
    "@cosmicmind/foundationjs": "0.0.1-rc-082626-1",
    "@cosmicmind/patternjs": "0.0.1-rc-082626-3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.12.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "lib0": "^0.2.117",
    "terser": "^5.50.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "yup": "^1.7.1"
  }
}
